{
  "name": "opendoc",
  "version": "0.1.0",
  "description": "Co-author plain markdown with AI agents: comment threads in a sidecar file, a CLI, and a local editor.",
  "type": "module",
  "bin": {
    "opendoc": "./bin/opendoc.js"
  },
  "exports": {
    ".": "./src/core/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "spec/",
    "dist/",
    "skills/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "desktop": "npm run build && electron desktop/main.js",
    "prepack": "npm run build",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "approx-string-match": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@milkdown/kit": "7.22.2",
    "ajv": "8.17.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2"
  }
}
