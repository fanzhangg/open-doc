{
  "name": "opendoc",
  "version": "0.1.0",
  "description": "Co-author plain markdown with AI buddies: comment threads in a sidecar file and a desktop editor.",
  "author": "fanzhangg",
  "type": "module",
  "exports": {
    ".": "./src/core/index.js"
  },
  "files": [
    "src/",
    "spec/",
    "dist/",
    "agents/"
  ],
  "scripts": {
    "icon:desktop": "electron scripts/make-icon.cjs",
    "build": "node scripts/build.js",
    "desktop": "npm run build && electron desktop/main.js",
    "prepack": "npm run build",
    "lint": "eslint .",
    "test": "node --test --test-timeout=300000 --test-force-exit \"test/*.test.js\"",
    "test:stress": "node --test --test-timeout=120000 --test-force-exit \"test/stress/*.test.js\"",
    "pack:desktop": "npm run build && electron-builder --dir",
    "dist:desktop": "npm run build && electron-builder",
    "smoke:desktop": "node scripts/smoke-desktop.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "approx-string-match": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-cjk-friendly": "2.0.2",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@milkdown/kit": "7.22.2",
    "ajv": "8.17.1",
    "electron": "44.4.5",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "remark-cjk-friendly": "2.3.2"
  }
}
