#!/bin/sh
# Runs a buddy on the Ponjo agent (docs/ponjo-agent.md): ponjo.mjs,
# next to this script, on your own node. Yours to change.
command -v node >/dev/null || { echo 'The Ponjo agent runs on Node.js: install it from https://nodejs.org, with node on PATH.' >&2; exit 1; }
exec node "$(dirname "$0")/ponjo.mjs"
