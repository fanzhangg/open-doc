{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendoc.dev/schema/v1/opendoc.schema.json",
  "title": "opendoc sidecar (version 1)",
  "description": "The X.md.opendoc.json file next to a markdown doc. See SPEC.md. Unknown fields are allowed at every level and must be preserved by tools.",
  "type": "object",
  "required": ["opendoc", "doc", "docHash", "participants", "threads"],
  "properties": {
    "opendoc": { "const": 1 },
    "doc": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$",
      "description": "File name of the doc, without a directory."
    },
    "docHash": {
      "oneOf": [
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "participants": {
      "type": "array",
      "items": { "$ref": "#/$defs/participant" }
    },
    "threads": {
      "type": "array",
      "items": { "$ref": "#/$defs/thread" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "kind": { "enum": ["human", "agent"] },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "participant": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "$ref": "#/$defs/kind" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "description": "Optional. Who the participant is, whatever their name (SPEC.md §2.4)." },
        "persona": { "type": "string", "maxLength": 120, "pattern": "^[^\\r\\n]*$", "description": "Agents only: one line that defines the agent." },
        "instructions": { "type": "string", "maxLength": 4000, "description": "Agents only: the details and rules behind the persona." }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["exact", "prefix", "suffix", "start"],
      "properties": {
        "exact": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "maxLength": 32 },
        "suffix": { "type": "string", "maxLength": 32 },
        "start": { "type": "integer", "minimum": 0 }
      }
    },
    "working": {
      "type": "object",
      "required": ["by", "since"],
      "properties": {
        "by": { "$ref": "#/$defs/name" },
        "since": { "$ref": "#/$defs/timestamp" }
      }
    },
    "thread": {
      "type": "object",
      "required": ["id", "anchor", "detached", "status", "resolvedBy", "resolvedAt", "working", "messages"],
      "properties": {
        "id": { "type": "string", "pattern": "^t_[A-Za-z0-9_-]{6,}$" },
        "anchor": {
          "oneOf": [{ "$ref": "#/$defs/anchor" }, { "type": "null" }]
        },
        "detached": { "type": "boolean" },
        "status": { "enum": ["open", "resolved"] },
        "resolvedBy": {
          "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }]
        },
        "resolvedAt": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "working": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/working" }
            },
            { "$ref": "#/$defs/working" },
            { "type": "null" }
          ]
        },
        "passed": {
          "type": "array",
          "items": { "$ref": "#/$defs/name" }
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        }
      }
    },
    "message": {
      "type": "object",
      "required": ["id", "author", "body", "mentions", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^m_[A-Za-z0-9_-]{6,}$" },
        "author": { "$ref": "#/$defs/participant" },
        "body": { "type": "string", "minLength": 1 },
        "mentions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edit" },
          "description": "Optional. What the author changed in the doc for this thread (SPEC.md §2.5)."
        },
        "undoes": {
          "type": "string",
          "pattern": "^m_[A-Za-z0-9_-]{6,}$",
          "description": "Optional. Id of the message whose edits this message reverted."
        },
        "proposal": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/change" },
          "description": "Optional. Changes the author suggests instead of making them (SPEC.md §2.6)."
        },
        "applies": {
          "type": "string",
          "pattern": "^m_[A-Za-z0-9_-]{6,}$",
          "description": "Optional. Id of the message whose proposal this message applied."
        }
      }
    },
    "change": {
      "type": "object",
      "required": ["before", "after", "prefix", "suffix", "start"],
      "properties": {
        "before": { "type": "string", "minLength": 1 },
        "after": { "type": "string" },
        "prefix": { "type": "string", "maxLength": 32 },
        "suffix": { "type": "string", "maxLength": 32 },
        "start": { "type": "integer", "minimum": 0 }
      }
    },
    "edit": {
      "type": "object",
      "required": ["before", "after", "prefix", "suffix", "start"],
      "properties": {
        "before": { "type": "string" },
        "after": { "type": "string" },
        "prefix": { "type": "string", "maxLength": 32 },
        "suffix": { "type": "string", "maxLength": 32 },
        "start": { "type": "integer", "minimum": 0 },
        "scope": { "enum": ["thread", "run"] }
      }
    }
  }
}
